# =============================================
# Darukaa.Earth — Environment Configuration
# =============================================
# Copy this file to .env and fill in your keys.
# NEVER commit the actual .env file to git.

# --- Gemini API Keys (comma-separated for rotation pool) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# --- Groq API Key ---
GROQ_API_KEY=your_groq_api_key_here

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# --- LLM Model Names (optional overrides) ---
LLM_REASONER_MODEL=gemini-1.5-flash
LLM_FAST_MODEL=gemini-1.5-flash
